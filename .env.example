# Mesmo valor do serviço interno (interno.dnawork.ai). Não invente outro banco.
DATABASE_URL=

# Segredo só deste portal. Não reutilize o JWT_SECRET do interno.
JWT_SECRET=

PORT=3333
HOST=0.0.0.0
CORS_ORIGIN=https://empresas.dnawork.ai
COOKIE_SECURE=true

# O interno chama este serviço em EMPRESAS_API_URL.
# Este serviço chama o interno em INTERNO_API_URL.
# SERVICE_TOKEN é o mesmo valor nos dois .env. Header: x-service-token
INTERNO_API_URL=https://interno.dnawork.ai
SERVICE_TOKEN=

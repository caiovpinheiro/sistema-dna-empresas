+                            </>
+                          ) : null}
+                        </div>
+                      </td>
+                    </tr>
+                  ))}
+                </tbody>
+              </table>
+            </div>
+            {erro ? <p style={{ color: "#be123c" }}>{erro}</p> : null}
+            {aviso ? <p style={{ color: "#0f766e" }}>{aviso}</p> : null}
+            <div style={{ display: "flex", gap: 8, marginTop: 16, flexWrap: "wrap" }}>
+              <Botao tom="laranja" onClick={() => verDocumento("original")}>Imprimir Original</Botao>
+              <Botao tom="verde" onClick={() => verDocumento("preview")}>Preview Assinaturas</Botao>
+              <Botao tom="claro" onClick={onClose}>Fechar</Botao>
+            </div>
+          </>
+        ) : null}
+      </div>
+    </div>
+  );
+}

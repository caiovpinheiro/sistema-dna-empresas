+            </h2>
+            {dados.enviado_em ? <p style={{ margin: "10px 0 0", color: "#475569" }}>Enviado para assinatura {dados.enviado_em}</p> : <p style={{ margin: "10px 0 0", color: "#475569" }}>Este documento ainda não foi enviado para assinatura digital.</p>}
+            {dados.status !== "Não enviado" ? (

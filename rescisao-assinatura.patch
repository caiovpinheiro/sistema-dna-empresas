+  return (
+    <div className="fixed inset-0 z-50 grid place-items-center p-4" style={{ background: "rgba(148, 163, 184, 0.45)" }} role="dialog" aria-modal="true" aria-labelledby="assinatura-titulo">
+      <div style={{ ...card, width: "min(440px, 100%)", padding: "28px 28px 22px" }}>
+        <h2 id="assinatura-titulo" style={{ margin: 0, fontSize: 28, fontWeight: 800, color: "#1e1b4b" }}>Assinatura digital</h2>

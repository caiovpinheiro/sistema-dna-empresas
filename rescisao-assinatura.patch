+                <button type="button" onClick={() => setConfirmarExclusao(true)} style={{ border: 0, background: "transparent", color: "#0369a1", fontWeight: 700, cursor: "pointer", padding: 0 }}>Excluir Assinatura Digital</button>
+              </p>
+            ) : null}
+            {incluindo ? (

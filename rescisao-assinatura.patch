+];
+
+function Botao({
+  children,
+  onClick,
+  tom,
+  disabled,
+  type = "button",
+}: {
+  children: string;
+  onClick?: () => void;
+  tom: "laranja" | "verde" | "claro";
+  disabled?: boolean;
+  type?: "button" | "submit";
+}) {
+  const cores = {
+    laranja: { background: "#f97316", color: "#ffffff", border: "1px solid #f97316" },
+    verde: { background: "#0f766e", color: "#ffffff", border: "1px solid #0f766e" },
+    claro: { background: "#ffffff", color: "#334155", border: "1px solid #cbd5e1" },
+  }[tom];
+  return (
+    <button
+      type={type}
+      disabled={disabled}
+      onClick={onClick}
+      style={{ ...cores, borderRadius: 8, padding: "7px 12px", fontWeight: 700, fontSize: 13, cursor: disabled ? "wait" : "pointer", opacity: disabled ? 0.6 : 1 }}
+    >
+      {children}
+    </button>
+  );
+}
+
+export function ConfirmacaoAssinatura({
+  enviando,

+    mutationFn: (token: string) => api(`/api/v1/contratacoes/${id}/assinatura/email`, { method: "POST", body: JSON.stringify({ token }) }),
+    onSuccess: async () => { setErro(""); setAviso("E-mail atualizado com o cadastro."); await atualizar(); },
+    onError: (error) => falha(error, "Não foi possível atualizar o e-mail."),
+  });
+  const excluirAssinante = useMutation({
+    mutationFn: (token: string) => api(`/api/v1/contratacoes/${id}/assinatura/excluir-assinante`, { method: "POST", body: JSON.stringify({ token }) }),
+    onSuccess: async () => { setErro(""); setAviso("Assinante excluído."); await atualizar(); },
+    onError: (error) => falha(error, "Não foi possível excluir o assinante."),
+  });
+  const adicionar = useMutation({
+    mutationFn: () => api(`/api/v1/contratacoes/${id}/assinatura/assinante`, { method: "POST", body: JSON.stringify({ nome, email, parte }) }),
+    onSuccess: async () => {
+      setErro("");
+      setAviso("Assinante adicionado.");
+      setNome("");
+      setEmail("");
+      setIncluindo(false);
+      await atualizar();
+    },
+    onError: (error) => falha(error, "Não foi possível adicionar o assinante."),
+  });
+  const excluirEnvelope = useMutation({
+    mutationFn: () => api(`/api/v1/contratacoes/${id}/assinatura`, { method: "DELETE" }),
+    onSuccess: async () => { await atualizar(); onClose(); },
+    onError: (error) => falha(error, "Não foi possível excluir a assinatura digital."),
+  });
+  const dados = query.data?.data;
+  function verDocumento(modo: "original" | "preview" | "baixar") {
+    if (modo === "preview" && dados?.preview_url?.startsWith("http")) {
+      window.open(dados.preview_url, "_blank");
+      return;
+    }
+    window.open(`/api/v1/contratacoes/${id}/assinatura/original${modo === "baixar" ? "?download=1" : ""}`, "_blank");
+  }
+
+  async function copiar(url: string) {
+    await navigator.clipboard.writeText(url);
+    setCopiado(url);
+    setAviso("Link copiado.");
+  }
+
+  return (

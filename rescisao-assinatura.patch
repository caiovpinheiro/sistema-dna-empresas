+
+function endereco(apiUrl: string, caminho: string, apiToken: string): string {
+  const base = apiUrl.replace(/\/$/, "");
+  const separador = caminho.includes("?") ? "&" : "?";
+  return `${base}${caminho}${separador}api_token=${encodeURIComponent(apiToken)}`;
+}
+
+async function chamarZap<T>(url: string, init: RequestInit, falha: string): Promise<T> {
+  const response = await fetch(url, init);
+  const body = await response.json().catch(() => null) as T | null;
+  if (!response.ok || !body) {
+    throw new AppError(502, "ZAPSIGN_RECUSOU", falha, { status: response.status });
+  }
+  return body;
+}
+
+export async function buscarDocumentoZapSign(apiUrl: string, apiToken: string, docToken: string): Promise<ZapDoc> {
+  return chamarZap<ZapDoc>(endereco(apiUrl, `/api/v1/docs/${docToken}/`, apiToken), { method: "GET" }, "A ZapSign não devolveu o documento.");
+}
+
+export async function adicionarAssinanteZapSign(apiUrl: string, apiToken: string, docToken: string, signer: ZapSigner): Promise<ZapSignerResult> {
+  return chamarZap<ZapSignerResult>(endereco(apiUrl, `/api/v1/docs/${docToken}/add-signer/`, apiToken), {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ name: signer.name, email: signer.email, auth_mode: "tokenEmail", lock_email: true }),
+  }, "A ZapSign não adicionou o assinante.");
+}
+
+export async function atualizarAssinanteZapSign(apiUrl: string, apiToken: string, signerToken: string, signer: { name: string; email: string }): Promise<ZapSignerResult> {
+  return chamarZap<ZapSignerResult>(endereco(apiUrl, `/api/v1/signers/${signerToken}/`, apiToken), {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ name: signer.name, email: signer.email }),
+  }, "A ZapSign não atualizou o e-mail.");
+}
+
+export async function reenviarAssinanteZapSign(apiUrl: string, apiToken: string, signerToken: string): Promise<void> {
+  const response = await fetch(endereco(apiUrl, `/api/v1/signers/${signerToken}/notify/`, apiToken), { method: "POST" });
+  if (!response.ok) {
+    throw new AppError(502, "ZAPSIGN_RECUSOU", "A ZapSign não reenviou o link.", { status: response.status });
+  }
+}
+
+export async function removerAssinanteZapSign(apiUrl: string, apiToken: string, signerToken: string): Promise<void> {
+  const response = await fetch(endereco(apiUrl, `/api/v1/signer/${signerToken}/remove/`, apiToken), { method: "DELETE" });
+  if (!response.ok) {
+    throw new AppError(502, "ZAPSIGN_RECUSOU", "A ZapSign não excluiu o assinante.", { status: response.status });
+  }
+}
+
+export async function excluirDocumentoZapSign(apiUrl: string, apiToken: string, docToken: string): Promise<void> {
+  const response = await fetch(endereco(apiUrl, `/api/v1/docs/${docToken}/`, apiToken), { method: "DELETE" });
+  if (!response.ok) {
+    throw new AppError(502, "ZAPSIGN_RECUSOU", "A ZapSign não excluiu a assinatura.", { status: response.status });

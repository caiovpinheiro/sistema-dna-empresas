+                  </tr>
+                </thead>
+                <tbody>
+                  {dados.signatarios.map((item) => (
+                    <tr key={`${item.tipo}-${item.token ?? item.email}`}>
+                      <td style={celula}>
+                        {item.parte}
+                        {item.editar ? <Link to={item.editar} style={{ marginLeft: 6, color: "#0369a1" }} aria-label={`Editar ${item.parte}`}>✎</Link> : null}
+                      </td>
+                      <td style={celula}>{item.nome || "—"}</td>
+                      <td style={celula}>
+                        <div>{item.email || "—"}</div>
+                        {item.url ? (
+                          <div style={{ marginTop: 6, display: "flex", gap: 8, alignItems: "center", flexWrap: "wrap" }}>
+                            <span style={{ color: "#0369a1", wordBreak: "break-all" }}>{item.url}</span>
+                            <Botao tom="claro" onClick={() => void copiar(item.url!)}>{copiado === item.url ? "Copiado" : "Copiar link"}</Botao>
+                          </div>
+                        ) : null}
+                      </td>
+                      <td style={celula}>{item.status}</td>
+                      <td style={celula}>{item.data || ""}</td>
+                      <td style={celula}>
+                        <div style={{ display: "flex", gap: 6, flexWrap: "wrap" }}>
+                          {item.baixar ? (
+                            <Botao tom="verde" onClick={() => verDocumento("baixar")}>Baixar</Botao>
+                          ) : item.token ? (
+                            <>
+                              <Botao tom="verde" disabled={reenviar.isPending} onClick={() => { setErro(""); reenviar.mutate(item.token!); }}>Reenviar Link</Botao>

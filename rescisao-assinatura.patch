+
+const ambiente = {
+  MAILJET_API_KEY: "",
+  MAILJET_SECRET_KEY: "",
+  MAILJET_FROM: "documentos@dnawork.ai",
+  MAILJET_FROM_NAME: "DNA Work",
+};
+
+test("sem chave no ambiente usa o segredo e o servidor salvos na conta", () => {
+  const conta = montarConta(ambiente, {
+    secret_jetmail: "segredo-da-conta",
+    remetente_jetmail: "contratos@dnawork.ai",
+    nome: "Assinatura de Contratos",
+    host: "smtp.gmail.com",
+    porta: "465",
+    usuario: "conta@dnawork.ai",
+    senha: "senha-da-conta",

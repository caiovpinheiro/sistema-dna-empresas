+import { ApiError, api } from "@/lib/api";
+
+export type SignatarioPainel = {
+  parte: string;
+  tipo: string;
+  nome: string;
+  email: string;
+  status: string;
+  data: string | null;
+  token: string | null;
+  url: string | null;
+  editar: string | null;
+  baixar: boolean;
+};
+
+export type PainelAssinaturaDados = {
+  nome: string;
+  status: string;
+  enviado_em: string | null;
+  original_url: string | null;
+  preview_url: string | null;
+  signatarios: SignatarioPainel[];
+};
+
+const card: CSSProperties = {
+  background: "#ffffff",
+  color: "#1e293b",
+  borderRadius: 18,
+  boxShadow: "0 24px 60px rgba(15, 23, 42, 0.22)",

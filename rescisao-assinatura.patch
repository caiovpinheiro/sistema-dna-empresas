+import type { Pool } from "pg";
+import nodemailer from "nodemailer";
+import type { AppConfig } from "../config.js";
+
+type AmbienteEmail = Pick<AppConfig, "MAILJET_API_KEY" | "MAILJET_SECRET_KEY" | "MAILJET_FROM" | "MAILJET_FROM_NAME">;
+import { AppError } from "./errors.js";
+import { enviarEmailMailjet } from "./mailjet.js";
+
+type Destino = { email: string; nome: string };
+type Anexo = { filename: string; contentType: string; base64: string };
+
+export type ContaEnvio = {
+  apiKey: string;
+  secret: string;
+  fromEmail: string;
+  fromName: string;
+  host: string;
+  port: number;
+  usuario: string;
+  senha: string;
+};
+
+type LinhaConta = {
+  secret_jetmail?: string | null;
+  remetente_jetmail?: string | null;
+  nome?: string | null;
+  host?: string | null;
+  porta?: string | null;
+  usuario?: string | null;
+  senha?: string | null;
+  enviadopor?: string | null;
+};
+
+const colunas = `s.secret_jetmail, s.remetente_jetmail, s.nome, s.host, s.porta, s.usuario, s.senha, s.enviadopor`;
+
+export function montarConta(config: AmbienteEmail, linha?: LinhaConta | null): ContaEnvio {
+  const porta = Number(linha?.porta || 465);
+  return {
+    apiKey: config.MAILJET_API_KEY,
+    secret: config.MAILJET_SECRET_KEY || linha?.secret_jetmail || "",
+    fromEmail: linha?.remetente_jetmail || linha?.enviadopor || config.MAILJET_FROM,
+    fromName: linha?.nome || config.MAILJET_FROM_NAME,
+    host: linha?.host || "",
+    port: Number.isInteger(porta) && porta > 0 ? porta : 465,
+    usuario: linha?.usuario || "",
+    senha: linha?.senha || "",
+  };
+}
+
+export function canalEnvio(conta: ContaEnvio): "mailjet" | "smtp" | "nenhum" {
+  if (conta.apiKey && conta.secret) return "mailjet";
+  if (conta.host && conta.usuario && conta.senha) return "smtp";
+  return "nenhum";
+}
+
+export async function carregarContaPorDescricao(db: Pool, config: AppConfig, descricao: string): Promise<ContaEnvio> {
+  const resultado = await db.query<LinhaConta>(`
+    SELECT ${colunas}
+    FROM dna_work.emailsvinculo v
+    JOIN dna_work.servidor_email s ON s.id::text = v.conta_email::text
+    WHERE v.descricao = $1
+    LIMIT 1
+  `, [descricao]);
+  return montarConta(config, resultado.rows[0]);
+}
+
+export async function carregarContaPorRemetente(db: Pool, config: AppConfig, remetente: string): Promise<ContaEnvio> {
+  const resultado = await db.query<LinhaConta>(`
+    SELECT ${colunas}
+    FROM dna_work.servidor_email s
+    WHERE lower(s.remetente_jetmail) = lower($1)
+    LIMIT 1
+  `, [remetente]);
+  return montarConta(config, resultado.rows[0]);
+}
+
+export async function enviarPelaConta(conta: ContaEnvio, input: {
+  to: Destino[];
+  subject: string;
+  html: string;
+  attachments?: Anexo[];
+}) {
+  const canal = canalEnvio(conta);
+  if (canal === "mailjet") {
+    return enviarEmailMailjet({
+      apiKey: conta.apiKey,
+      secret: conta.secret,
+      fromEmail: conta.fromEmail,
+      fromName: conta.fromName,
+      to: input.to,
+      subject: input.subject,
+      html: input.html,
+      attachments: input.attachments,
+    });
+  }
+  if (canal === "smtp") {
+    const transporte = nodemailer.createTransport({
+      host: conta.host,
+      port: conta.port,
+      secure: conta.port === 465,
+      auth: { user: conta.usuario, pass: conta.senha },
+    });
+    const destinos = input.to.filter((item) => item.email.includes("@"));
+    if (!destinos.length) throw new AppError(422, "EMAIL_AUSENTE", "Nenhum destinatário com e-mail.");
+    await transporte.sendMail({
+      from: { name: conta.fromName, address: conta.fromEmail },
+      to: destinos.map((item) => ({ name: item.nome || item.email, address: item.email })),
+      subject: input.subject,
+      html: input.html,
+      attachments: (input.attachments ?? []).map((item) => ({
+        filename: item.filename,
+        content: Buffer.from(item.base64, "base64"),
+        contentType: item.contentType,
+      })),
+    });
+    return { enviados: destinos.map((item) => item.email) };
+  }
+  throw new AppError(503, "MAILJET_NAO_CONFIGURADO", "Defina MAILJET_API_KEY e MAILJET_SECRET_KEY no ambiente.");
+}

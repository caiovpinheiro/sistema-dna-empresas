+            <p style={{ margin: 0, fontSize: 18, color: "#334155" }}>Documento enviado para assinatura.</p>
+            <p style={{ margin: 0, fontSize: 18, color: "#334155" }}>Envelope enviado.</p>
+          </div>
+        ) : (
+          <p style={{ margin: "18px 0 0", fontSize: 18, color: "#334155" }}>Enviar este documento para assinatura digital?</p>
+        )}
+        {erro ? <p style={{ margin: "12px 0 0", color: "#be123c", fontSize: 14 }}>{erro}</p> : null}
+        {enviado ? null : (
+          <div style={{ display: "flex", gap: 10, marginTop: 22 }}>
+            <Botao tom="laranja" disabled={enviando} onClick={onSim}>{enviando ? "Enviando…" : "Sim"}</Botao>
+            <Botao tom="claro" disabled={enviando} onClick={onNao}>Não</Botao>
+          </div>
+        )}
+        <button type="button" onClick={onVerDocumento} style={{ marginTop: 18, padding: 0, border: 0, background: "transparent", color: "#f97316", fontWeight: 700, cursor: "pointer" }}>
+          Ver documento
+        </button>
+      </div>
+    </div>
+  );
+}
+
+export function PainelAssinatura({ id, onClose }: { id: string; onClose: () => void }) {
+  const client = useQueryClient();
